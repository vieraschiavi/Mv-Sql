# dependencias y builds
node_modules/
desktop/dist/
desktop/release/
.venv/
__pycache__/
*.pyc

# artefactos de tools/build_cython.py (se generan localmente o en CI —
# nunca se comitean: son binarios especificos de cada plataforma/version
# de Python, y el .c intermedio de Cython no aporta nada versionado)
app-python/*.pyd
app-python/*.so
app-python/*.c
app-python/build/

# datos locales
app-python/cartera_demo.db
app-python/catalogo_demo.json
.mvsql/

# instalador del propietario (makensis -DPROPIETARIO=1): solo se publica
# como asset privado de GitHub Actions (ver build-desktop.yml), nunca se
# comitea. paquete/ no la sirve nadie públicamente (a diferencia de la vieja
# web/downloads/), pero igual no va al repo: lleva una licencia real
# embebida que no tiene por qué quedar en el historial de git.
paquete/MV-SQL-NLP-Setup-OWNER.exe

# entornos
.env
.env.local
licencia_mvsql.json
.mvsql_trial.json
.eula_aceptado
.idioma
.accesos_ok
.extras_ok
.disco_ok
instalacion.log
equipo.json
auditoria.db

# Licencia del propietario para la build owner de Electron: la escribe el
# workflow en el runner y NUNCA se commitea. Si entrara al repo, cualquier
# build (incluida la de clientes) saldria con acceso hasta 2099.
desktop/licencia_owner.json

# Zip del propietario (via .bat, con licencia hasta 2099 adentro). Nunca
# se commitea — mismo motivo que el .exe del propietario arriba.
paquete/mvsql-nlp-app-OWNER.zip

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Conversor a version propietario CON la licencia real adentro (ver
# owner/README.md y tools/generar_conversor_owner.py). Solo se genera
# localmente; owner/plantilla-convertir-a-dueno.ps1 (sin licencia real)
# es la unica version que se commitea.
owner/dist/
